    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "description": "JWT Authorization header using the Bearer scheme."
            }
        },
        "parameters": {
            "id": {
                "name": "id",
                "in": "path",
                "required": true,
                "schema": {
                    "type": "integer",
                    "format": "int32"
                }
            }
        },
        "schemas": {
            "MessageResponse": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "Message": {
                        "type": "string",
                        "examples": [
                            "Curso criado com sucesso!"
                        ]
                    }
                },
                "required": [
                    "Message"
                ]
            },
            "UsuarioAuthResponse": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "Nome": {
                        "type": "string",
                        "examples": [
                            "João Silva"
                        ]
                    },
                    "Token": {
                        "type": "string",
                        "description": "JWT de autenticação"
                    }
                },
                "required": [
                    "Nome",
                    "Token"
                ]
            },
            "CursoPostDTO": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "nome": {
                        "type": "string",
                        "maxLength": 50
                    },
                    "descricao": {
                        "type": "string",
                        "maxLength": 150
                    }
                },
                "required": [
                    "nome",
                    "descricao"
                ]
            },
            "CursoPutDTO": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "nome": {
                        "type": "string",
                        "maxLength": 50
                    },
                    "descricao": {
                        "type": "string",
                        "maxLength": 150
                    }
                },
                "required": [
                    "id",
                    "nome",
                    "descricao"
                ]
            },
            "CursoGetDTO": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "nome": {
                        "type": "string"
                    },
                    "descricao": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "nome",
                    "descricao"
                ]
            },
